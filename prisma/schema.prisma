generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRoleStatus {
  ACTIVE
  REVOKED
}

enum AuthSessionEndReason {
  ROTATED
  LOGOUT
  ALL_DEVICES_LOGOUT
  REPLAY_DETECTED
  USER_DISABLED
  EXPIRED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(320)
  name          String    @db.VarChar(160)
  passwordHash  String    @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  accessVersion Int       @default(0) @map("access_version")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]    @relation("UserRoleMember")
  roleAssignmentsMade UserRole[]    @relation("UserRoleAssignedBy")
  roleRevocationsMade UserRole[]    @relation("UserRoleRevokedBy")
  sessions            AuthSession[]
  auditEvents         AuditEvent[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@index([isActive, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(120)
  description String? @db.VarChar(500)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  roleId       String         @map("role_id") @db.Uuid
  status       UserRoleStatus @default(ACTIVE)
  assignedById String?        @map("assigned_by_id") @db.Uuid
  revokedById  String?        @map("revoked_by_id") @db.Uuid
  assignedAt   DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(6)

  user       User  @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy  User? @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId, status])
  @@map("user_roles")
}

model AuthSession {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  tokenHash       String                @unique @map("token_hash") @db.Char(64)
  familyId        String                @map("family_id") @db.Uuid
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(6)
  familyExpiresAt DateTime              @map("family_expires_at") @db.Timestamptz(6)
  issuedAt        DateTime              @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?             @map("last_used_at") @db.Timestamptz(6)
  endedAt         DateTime?             @map("ended_at") @db.Timestamptz(6)
  replacedById    String?               @unique @map("replaced_by_id") @db.Uuid
  endReason       AuthSessionEndReason? @map("end_reason")
  ipHash          String?               @map("ip_hash") @db.Char(43)
  userAgentHash   String?               @map("user_agent_hash") @db.Char(43)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement AuthSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  source      AuthSession? @relation("SessionRotation")

  @@index([userId, endedAt])
  @@index([familyId, endedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  resource   String   @db.VarChar(80)
  resourceId String?  @map("resource_id") @db.VarChar(160)
  traceId    String   @map("trace_id") @db.VarChar(80)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@map("audit_events")
}
