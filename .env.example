# PostgreSQL is the default and supported persistence layer.
DATABASE_URL=postgresql://postgres:password@localhost:5432/api_template?schema=public

NODE_ENV=development
PORT=9000
API_PREFIX=api
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_REGISTRATION_ENABLED=true
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_IDLE_DAYS=7
AUTH_REFRESH_ABSOLUTE_DAYS=30
AUTH_COOKIE_SECURE=false

# Required for the E2E suite because it creates and removes isolated e2e-* records.
E2E_ALLOW_DATABASE_MUTATION=false

# Generate at least 32 random bytes and encode them as base64.
AUTH_SECRET_BASE64=
